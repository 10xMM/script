            send_chat(saylogs.juju_missing)
        end
        return
    end
    local possible_names = {
        "fake position", "fakeposition", "fake_position",
        "fake pos", "fakepos", "fakeposition"
    }
  
    local el = nil
    for _, name in ipairs(possible_names) do
        el = juju.find_element("anti", name)
        if el then break end
    end
  
    if not el then
        for _, name in ipairs(possible_names) do
            el = juju.find_element("misc", name)
            if el then break end
        end
    end
    if not el then
        if say_logs_enabled then
            send_chat(saylogs.fakepos_not_found)
        end
        warn("[Jujustand Debug] Fake Position element not found after search")
        return
    end
    local state = (arg:lower() ~= "off") 
    local success, err = pcall(function()
        if el.set_toggle then
            el:set_toggle(state)
        elseif el.toggle then
            el:toggle() 
        end
    end)
    if success then
        if say_logs_enabled then
            send_chat(string.format(saylogs.fakepos_toggle, state and "ENABLED" or "DISABLED"))
        end
        warn("[Jujustand] Successfully set Fake Position to " .. tostring(state))
    else
        if say_logs_enabled then
            send_chat(string.format(saylogs.fakepos_failed, tostring(err)))
        end
        warn("[Jujustand Error] Toggle failed: " .. tostring(err))
    end
