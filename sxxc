local lastCommandTime = 0
local function create_chat_connection()
    local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
    if not channel then return false end
    local conn = channel.MessageReceived:Connect(function(msg)
        local speaker = Players:GetPlayerByUserId(msg.TextSource and msg.TextSource.UserId or 0)
        if not speaker or not is_authorized(speaker) then return end
        local text = msg.Text
        local lowerText = text:lower()
        local escapedPrefix = patternEscape(COMMAND_PREFIX)
        if not lowerText:find("^" .. escapedPrefix) then return end
        if tick() - lastCommandTime < SETTINGS.COMMAND_COOLDOWN then return end
        lastCommandTime = tick()
        local args = {}
        for w in text:gmatch("%S+") do table.insert(args, w) end
        if #args < 1 then return end
        local fullCmd = args[1]
        local cmd = fullCmd:sub(#COMMAND_PREFIX + 1):lower()
        local arg = table.concat(args, " ", 2)
        if cmd == bring_cmd then
            if arg == "stop" or arg == "cancel" or arg == "off" then
                handleFixCommand()
            elseif arg ~= "" then
                handleBringCommand(arg, speaker.Name)
            end
        elseif cmd == down_cmd and arg ~= "" then
            handleDownCommand(arg)
        elseif cmd == loopkill_cmd then
            handleLoopkillCommand(arg)
        elseif cmd == protect_cmd then
            handleProtectCommand(arg, 1)
        elseif cmd == protect2_cmd then
            handleProtectCommand(arg, 2)
        elseif cmd == aura_cmd then
            handleAuraCommand(arg)
        elseif cmd == reset_cmd then
            handleResetCommand()
        elseif cmd == cashdrop_cmd then
            handleCashDropCommand(arg)
        elseif cmd == rejoin_cmd then
            handleRejoinCommand()
        elseif cmd == say_cmd and arg ~= "" then
            handleSayCommand(arg)
        elseif cmd == void_cmd then
            handleVoidCommand(arg)
        elseif cmd == fakepos_cmd or cmd == fakepos_alias then
            handleFakeposCommand(arg)
        elseif cmd == velocity_cmd or cmd == vel_cmd then
            handleVelocityDesyncCommand(arg)
        elseif cmd == nd_cmd then
            handleNetworkDesyncCommand(arg)
        elseif cmd == sender_cmd then
            handleSenderRateCommand(arg)
        elseif cmd == desync_cmd then
            handleDesyncCommand(arg)
        elseif cmd == animationid_cmd and arg ~= "" then
            handleAnimationIdCommand(arg)
        elseif cmd == animationsp_cmd and arg ~= "" then
            handleAnimationSpeedCommand(arg)
        elseif cmd == animation_cmd and arg == "off" then
            handleAnimationOff()
        elseif cmd == stand_cmd or cmd == stand_strafe_cmd then
            if arg == "off" then
                stand_active = false
                stand_strafing = false
            elseif arg == "" then
                handleStandCommand()
                if cmd == stand_strafe_cmd then handleStandStrafeCommand("on") end
            end
        elseif cmd == pos_cmd and arg ~= "" then
            handleStandPositionCommand(arg)
        elseif cmd == saylogs_cmd then
            handleSayLogsCommand(arg)
        elseif cmd == killsay_cmd then
            handleKillSayCommand(arg)
        elseif cmd == stomp_cmd then
            handleAutoStompCommand(arg)
        elseif cmd == here_cmd then
            handleHereCommand(arg)
        elseif cmd == reloadkillsay_cmd then
            load_killsay_messages()
            if say_logs_enabled then
                send_chat(saylogs.killsay_reload)
            end
        elseif cmd == lyrics_cmd then
            local subcmd = arg:lower()
            if subcmd == "on" or subcmd == "" then
                load_lyrics()
                lyrics_index = 1
                lyrics_active = true
                if say_logs_enabled then
                    send_chat(string.format(saylogs.lyrics_start, tostring(#lyrics_lines), tostring(LYRICS_DELAY)))
                end
            elseif subcmd == "off" then
                lyrics_active = false
                if say_logs_enabled then
                    send_chat(saylogs.lyrics_stop)
                end
            elseif subcmd == "reload" then
                load_lyrics()
                if say_logs_enabled then
                    send_chat(string.format(saylogs.lyrics_reload, tostring(#lyrics_lines)))
                end
            else
                if say_logs_enabled then
                    send_chat(string.format(saylogs.lyrics_usage, COMMAND_PREFIX))
                end
            end
        elseif cmd == prefix_cmd then
            local newPrefix = arg:match("^%s*(.-)%s*$")
            if newPrefix == "" or newPrefix == nil then
                if say_logs_enabled then
                    send_chat(string.format(saylogs.prefix_current, COMMAND_PREFIX, COMMAND_PREFIX))
                end
                return
            end
            if #newPrefix > 8 then
                if say_logs_enabled then
                    send_chat(saylogs.prefix_too_long)
                end
                return
            end
            COMMAND_PREFIX = newPrefix
            save_prefix()
            if say_logs_enabled then
                send_chat(string.format(saylogs.prefix_changed, COMMAND_PREFIX))
            end
        end
    end)
    connections.chat = conn
    return true
end
