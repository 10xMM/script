                if enemyHum and enemyHum.Health <= 0 then
                    lastDamagerWhoHitMaster = nil
                end
            end
            if protectMode == 1 and shouldStomp ~= lastStompState then
                setAutoStomp(shouldStomp)
                lastStompState = shouldStomp
                if say_logs_enabled then
                    if shouldStomp then
                        send_chat(saylogs.protect_stomp_on)
                    else
                        send_chat(saylogs.protect_stomp_off)
                    end
                end
            end
            local currentTarget = juju.get_active_ragebot_target and juju.get_active_ragebot_target()
            if currentTarget and currentTarget ~= LocalPlayer then
                local shouldUntarget = false
                if juju.is_player_dead then
                    if juju.is_player_dead(currentTarget) then shouldUntarget = true end
                else
                    local tChar = currentTarget.Character
                    if tChar then
                        local tHum = tChar:FindFirstChildWhichIsA("Humanoid")
                        if tHum and tHum.Health <= 0 then shouldUntarget = true end
                    else
                        shouldUntarget = true
                    end
                end
                if shouldUntarget then
                    pcall(juju.set_active_ragebot_target, nil)
                    if say_logs_enabled then send_chat(saylogs.protect_eliminated) end
                end
            end
        end
        if auraFollow then
            local closest, minDist = nil, math.huge
            for _, plr in Players:GetPlayers() do
                if plr ~= LocalPlayer and is_whitelisted(plr) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (myHRP.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = plr
                    end
                end
            end
            if closest and closest.Character and closest.Character:FindFirstChild("HumanoidRootPart") then
                local tHRP = closest.Character.HumanoidRootPart
                auraAngle = auraAngle + SETTINGS.AURA_SPEED * RunService.RenderStepped:Wait()
                local x = math.cos(auraAngle) * SETTINGS.AURA_DISTANCE
                local z = math.sin(auraAngle) * SETTINGS.AURA_DISTANCE
                perfect_teleport(myHRP, tHRP.Position + Vector3.new(x, 0, z))
            end
        end
        if stand_active then
            local auth = Players:FindFirstChild(SETTINGS.AUTHORIZED_USER)
            if auth and auth.Character and auth.Character:FindFirstChild("HumanoidRootPart") then
                local targetHRP = auth.Character.HumanoidRootPart
                local offset
                if stand_strafing then
                    local angle = tick() * 2
                    local r = 5
                    offset = targetHRP.Position + Vector3.new(math.cos(angle)*r, 5, math.sin(angle)*r)
                else
                    local right = targetHRP.CFrame.RightVector
                    local look = targetHRP.CFrame.LookVector
                    if stand_position == 1 then
                        offset = targetHRP.Position - right * 5 + Vector3.new(0,5,0)
                    elseif stand_position == 3 then
                        offset = targetHRP.Position + right * 5 + Vector3.new(0,5,0)
                    else
                        offset = targetHRP.Position - look * 5 + Vector3.new(0,5,0)
                    end
                end
                myHRP.CFrame = CFrame.new(offset) * targetHRP.CFrame.Rotation
            end
        end
        if cashdrop and (tick() - last_cashdrop_time >= CASH_DROP_INTERVAL) then
            MainEvent:FireServer("DropMoney", cashdrop_amount)
            last_cashdrop_time = tick()
        end
    end
end)
