local function playAnimation()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
    for _, t in ipairs(humanoid:GetPlayingAnimationTracks()) do t:Stop(0.1) end
    if currentAnimTrack then currentAnimTrack:Stop(0.1) currentAnimTrack = nil end
    if not savedAnimation.id then return end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(savedAnimation.id)
    local success, track = pcall(function() return animator:LoadAnimation(anim) end)
    if success and track then
        track.Priority = Enum.AnimationPriority.Action4
        track.Looped = true
        track:Play(0.2)
        track:AdjustSpeed(savedAnimation.speed or SETTINGS.DEFAULT_ANIM_SPEED)
        currentAnimTrack = track
    end
